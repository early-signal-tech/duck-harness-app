{
  "name": "duck-harness-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Duck Harness plugins (DH-1, later EH-1) and their shared UI kit.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dh1": "npm run tauri -w dh1-app -- dev",
    "build": "npm run build -w dh1-app",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6"
  }
}
